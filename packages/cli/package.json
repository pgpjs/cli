{
  "name": "pgpjs-cli",
  "version": "1.0.0",
  "description": "PGPJS CLI — OpenPGP encryption toolkit for developers, CI, and AI agents",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "pgpjs": "./bin/pgpjs.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config-export.d.ts",
      "import": "./dist/config-export.js"
    }
  },
  "files": ["dist", "bin", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "@pgpjs/config": "workspace:*",
    "@pgpjs/core": "workspace:*",
    "@pgpjs/mcp": "workspace:*",
    "@pgpjs/security": "workspace:*",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "jiti": "^2.4.2",
    "openpgp": "6.3.1",
    "ora": "^8.2.0",
    "zod": "^3.25.76"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "openpgp",
    "pgp",
    "encryption",
    "cli",
    "mcp",
    "nextjs",
    "typescript"
  ]
}
